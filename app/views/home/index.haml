.container.py-4
  - flash.each do |type, message|
    .alert.mt-3{ class: flash_alert_class(type) }= message

  .row.g-4
    .col-lg-4
      .card
        .card-body
          %h2.card-title Brands
          - if @brands.many?
            .list-group.mb-3#brand_switcher
              - @brands.each do |brand|
                = link_to brand.name, root_path(brand_id: brand.id), id: dom_id(brand, :switch), class: brand_nav_link_class(brand, @brand)
          = render "brands/new_form"

    .col-lg-8
      .card.mb-4
        .card-body
          %h2.card-title Brand
          = render "brands/form"

      .card.mb-4
        .card-body
          %h2.card-title Settings
          #brand_settings
            = render partial: "brand_settings/setting", collection: @brand_settings, as: :setting
          #brand_setting_form
            = render "brand_settings/form", setting: @brand.settings.new

      .card
        .card-body
          %h2.card-title Users
          %p.mb-3
            Total:
            %span#users_count= @brand.users_count
          #users
            = render @brand_users
          #user_form
            = render "users/form"
